region              = "us-east-1"
cluster_name        = "gitlab-runners"

# Required (no defaults).
session_server_hostname = "runners.example.com"
route53_zone_id         = "Z0123456789ABCDEFGHIJ"
gitlab_project_path     = "mygroup/myrepo"

# Sensitive — prefer env: export TF_VAR_gitlab_runner_token=glrt-...
# gitlab_runner_token = "glrt-xxxxxxxxxxxxxxxxxxxx"

# Optional toggles.
create_demo_secret = true
runner_concurrency = 10

# Required: who can reach the EKS public API endpoint. No safe default ships;
# pick the smallest set that works for your operators (e.g. office egress).
cluster_endpoint_public_access_cidrs = ["203.0.113.0/24"]

# Required: GitLab.com egress CIDRs that need to reach the session_server NLB
# for the interactive web terminal. The values below are placeholders — pull
# the canonical list from
# https://docs.gitlab.com/ee/user/gitlab_com/#ip-range
# and replace these entries before applying. Update on a cadence (or whenever
# GitLab announces a change).
session_server_source_cidrs = [
  "203.0.113.0/24",
]
